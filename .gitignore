# ===== Banco de dados =====
# O arquivo .db NAO vai para o GitHub.
# Outro desenvolvedor recria o banco rodando os scripts de sql/ e app/seed.py
database/*.db
database/*.sqlite
database/*.sqlite3

# ===== Configuracoes sensiveis =====
# O .env guarda senhas e chaves. Nunca subir para o GitHub.
.env

# ===== Ambiente virtual Python =====
venv/
.venv/
env/

# ===== Arquivos temporarios do Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ===== Editores =====
# Ignoramos a pasta .vscode inteira, MENOS o settings.json.
# O "!" significa "excecao: este aqui pode ir".
# Assim seu colega recebe a configuracao do interpretador ja pronta.
.vscode/*
!.vscode/settings.json
.idea/

# ===== Windows =====
Thumbs.db
desktop.ini

# ===== Logs =====
*.log

# ===== Arquivo gerado para o Copilot Studio =====
# Ele e criado pelo comando "python gerar_openapi.py" e contem o
# endereco do servidor. Cada pessoa gera o seu quando precisar, entao
# nao faz sentido versionar.
openapi-central.json

# ===== Copias de seguranca do banco =====
# Contem dados pessoais. Nunca vao para o GitHub.
backups/
