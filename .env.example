# ===================================================================
# MODELO DE CONFIGURACAO
# ===================================================================
# Este arquivo (.env.example) VAI para o GitHub e serve de modelo.
#
# Para usar no seu computador:
#   1. copie este arquivo
#   2. renomeie a copia para  .env
#   3. troque os valores
#
# O arquivo .env NAO vai para o GitHub (esta no .gitignore).
# No servidor, estes valores sao cadastrados como "variaveis de
# ambiente" no painel do provedor — nao se envia arquivo .env.
# ===================================================================

# "desenvolvimento" no seu computador, "producao" no servidor.
# Em producao o cookie de sessao passa a exigir HTTPS.
AMBIENTE=desenvolvimento

# Chave que assina o cookie de sessao do login.
# Gere uma nova com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Chave que sistemas parceiros usam para chamar a nossa API.
# Gere uma nova com:  python -c "import secrets; print(secrets.token_hex(24))"
# Se ficar vazia, a API responde 503 e fica desligada.
API_KEY=troque-esta-chave-tambem

# ===================================================================
# SENHAS DE ACESSO
# ===================================================================
# Cada CATEGORIA tem a sua senha, compartilhada por todas as pessoas
# daquela categoria. O e-mail digitado no login e livre: serve para
# registrar quem acessou.
#
# TROQUE ESTAS SENHAS antes de colocar o sistema no ar.
# Os valores abaixo sao apenas exemplos.
SENHA_ESTIPULANTE=defina-a-senha-do-estipulante
SENHA_CORRETORA=defina-a-senha-da-corretora
SENHA_SEGURADORA=defina-a-senha-da-seguradora

# ===================================================================
# OPCIONAL
# ===================================================================
# Cria as tabelas e carrega os dados iniciais quando o sistema liga.
# Deixe "sim" para conseguir subir no servidor sem rodar comandos.
CRIAR_BANCO_AO_INICIAR=sim
